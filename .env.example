# Anthropic API key — primary for the Tailor.cv live tool
# Get yours at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# OpenAI API key — fallback for the Tailor.cv live tool
# Get yours at https://platform.openai.com/
OPENAI_API_KEY=your_openai_api_key_here

# Groq API key — high-speed free-tier option for the Tailor.cv live tool
# Get yours at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Auth — gates the "AI Tailor & Full Rewrite" feature to the owner only.
# The public "Analyze Alignment" check stays open to all visitors.
ADMIN_EMAIL=moonahmed786@gmail.com

# bcrypt hash of the owner password. Generate one with:
#   node -e "console.log(require('bcryptjs').hashSync('your-password-here', 12))"
ADMIN_PASSWORD_HASH=replace_with_bcrypt_hash

# Random 32+ char string used to sign session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
SESSION_SECRET=replace_with_a_long_random_string_at_least_32_chars
